root = true

# Kotlin style shared by every module (ktlint, Android mode). Continuation indent 4 avoids conflicts with detekt.
[*.{kt,kts}]
indent_size = 4
ij_kotlin_continuation_indent_size = 4
ktlint_function_naming_ignore_when_annotated_with = Composable

[**/build/generated/**/*.{kt,kts}]
ktlint = disabled
